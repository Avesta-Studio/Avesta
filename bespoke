<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>DYNAST | Bespoke Watch Customizer & Studio</title>
    <link rel="canonical" href="https://dynast.co.in/customize.html">
    <link rel="icon" type="image/png" href="favicon.png">
    <meta name="description" content="Design your own custom luxury timepiece with DYNAST. Customize case color, black or white dial, custom name or photo dial, strap material, clasp, and skeleton caseback.">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: '#FFD700',
                        lightgold: '#FFE87C',
                        darkgold: '#B8860B',
                        black: '#050505',
                        darkgray: '#101010',
                        cardbg: '#141414'
                    },
                    fontFamily: {
                        'sans': ['Inter', 'sans-serif'],
                        'serif': ['Cinzel', 'serif'],
                        'decorative': ['Cinzel Decorative', 'cursive'],
                        'script': ['Great Vibes', 'cursive']
                    }
                }
            }
        }
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@500;600;700&family=Great+Vibes&family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top, #241b0b 0%, #060606 55%, #020202 100%);
            background-attachment: fixed;
            color: #ffffff;
            margin: 0;
            overflow-x: hidden;
        }

        .cinzel-decorative {
            font-family: 'Cinzel Decorative', cursive;
            font-weight: 700;
            letter-spacing: 0.16em;
        }

        .serif-text {
            font-family: 'Cinzel', serif;
        }

        .gold-panel {
            background: linear-gradient(145deg, rgba(22, 22, 22, 0.95), rgba(8, 8, 8, 0.98));
            border: 1px solid rgba(255, 215, 0, 0.3);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 25px rgba(255, 215, 0, 0.08);
        }

        .btn-gold {
            background: linear-gradient(135deg, #FFD700 0%, #B8860B 100%);
            color: #050505;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-gold:hover {
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.6);
            transform: translateY(-1px);
        }

        .option-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 215, 0, 0.2);
            transition: all 0.25s ease;
            cursor: pointer;
        }

        .option-card:hover {
            border-color: rgba(255, 215, 0, 0.6);
            background: rgba(255, 215, 0, 0.07);
        }

        .option-card.active {
            border-color: #FFD700;
            background: rgba(255, 215, 0, 0.15);
            box-shadow: 0 0 18px rgba(255, 215, 0, 0.25);
        }

        .swatch-btn {
            transition: all 0.25s ease;
        }

        .swatch-btn.active {
            outline: 2px solid #FFD700;
            outline-offset: 3px;
            transform: scale(1.08);
        }

        @keyframes balanceOscillate {
            0% { transform: rotate(-28deg); }
            50% { transform: rotate(28deg); }
            100% { transform: rotate(-28deg); }
        }

        .balance-wheel-anim {
            transform-origin: 200px 215px;
            animation: balanceOscillate 0.6s infinite ease-in-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #070707; }
        ::-webkit-scrollbar-thumb { background: #B8860B; border-radius: 3px; }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-gold selection:text-black">

    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-40 bg-black/90 backdrop-blur-md border-b border-gold/30 px-4 lg:px-8 py-3.5">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <!-- Brand & Back Link -->
            <div class="flex items-center gap-4">
                <a href="https://dynast.co.in" class="text-xs text-gold/80 hover:text-gold flex items-center gap-1.5 border border-gold/30 px-3 py-1.5 rounded-full transition">
                    <i class="fa-solid fa-arrow-left"></i> <span class="hidden sm:inline">Main Store</span>
                </a>
                <div>
                    <a href="https://dynast.co.in" class="cinzel-decorative text-xl sm:text-2xl text-lightgold tracking-widest block leading-none">DYNAST</a>
                    <span class="text-[9px] uppercase tracking-[0.28em] text-gold/80 block mt-0.5">Bespoke Horology Studio</span>
                </div>
            </div>

            <!-- Live Total & Customer Account Controls -->
            <div class="flex items-center gap-2.5 sm:gap-4">
                <div class="bg-gold/10 border border-gold/40 px-3.5 py-1.5 rounded-xl text-right">
                    <span class="text-[9px] uppercase tracking-widest text-gold/80 block">Live Custom Total</span>
                    <span id="navTotalPrice" class="serif-text text-sm sm:text-base font-bold text-lightgold">₹4,998</span>
                </div>

                <!-- History / Saved Button -->
                <button onclick="openAccountModal('history')" class="relative border border-gold/40 bg-white/5 hover:bg-gold/15 text-lightgold px-3 py-2 rounded-xl text-xs font-medium flex items-center gap-2 transition" title="Customization History & Orders">
                    <i class="fa-solid fa-clock-rotate-left text-gold"></i>
                    <span class="hidden md:inline">History & Orders</span>
                    <span id="historyCountBadge" class="bg-gold text-black text-[10px] font-bold px-1.5 py-0.2 rounded-full">0</span>
                </button>

                <!-- Login / Account Button -->
                <button id="authNavBtn" onclick="handleAuthButtonClick()" class="btn-gold px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-md">
                    <i class="fa-solid fa-user"></i>
                    <span id="authNavText">Sign In</span>
                </button>
            </div>
        </div>
    </header>
    <!-- MAIN CUSTOMIZER WORKSPACE -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- LEFT COLUMN: LIVE WATCH RENDERER (STICKY ON DESKTOP) -->
            <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-4">
                <div class="gold-panel rounded-3xl p-5 relative overflow-hidden">
                    
                    <!-- Top Status Bar Inside Preview -->
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3 z-10 relative">
                        <span class="text-[10px] uppercase tracking-[0.2em] bg-gold/15 border border-gold/40 text-lightgold px-3 py-1 rounded-full font-semibold">
                            <i class="fa-solid fa-wand-magic-sparkles mr-1 text-gold"></i> Live 2D/3D Studio Render
                        </span>

                        <!-- View Switcher: Front / Back / Split -->
                        <div class="flex bg-black/80 border border-gold/30 rounded-xl p-0.5 text-[11px]">
                            <button id="viewFrontBtn" onclick="setWatchView('front')" class="px-2.5 py-1 rounded-lg bg-gold text-black font-bold transition">Front Dial</button>
                            <button id="viewBackBtn" onclick="setWatchView('back')" class="px-2.5 py-1 rounded-lg text-gray-300 hover:text-gold transition">Back Case</button>
                            <button id="viewSplitBtn" onclick="setWatchView('split')" class="px-2.5 py-1 rounded-lg text-gray-300 hover:text-gold transition">Both</button>
                        </div>
                    </div>

                    <!-- WATCH STAGE CONTAINER -->
                    <div id="watchStageContainer" class="grid grid-cols-1 gap-4 items-center justify-items-center py-2">
                        
                        <!-- 1. FRONT WATCH SVG RENDERER -->
                        <div id="frontWatchWrapper" class="w-full flex flex-col items-center">
                            <svg id="frontWatchSvg" viewBox="0 0 400 540" class="w-full max-w-[310px] drop-shadow-[0_25px_35px_rgba(0,0,0,0.95)] select-none">
                                <defs>
                                    <!-- Case Metallic Gradients -->
                                    <linearGradient id="caseGrad-gold" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#FFF3B0"/>
                                        <stop offset="30%" stop-color="#FFD700"/>
                                        <stop offset="65%" stop-color="#B8860B"/>
                                        <stop offset="100%" stop-color="#5A3E04"/>
                                    </linearGradient>
                                    <linearGradient id="caseGrad-silver" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#FFFFFF"/>
                                        <stop offset="35%" stop-color="#CBD5E1"/>
                                        <stop offset="70%" stop-color="#94A3B8"/>
                                        <stop offset="100%" stop-color="#475569"/>
                                    </linearGradient>
                                    <linearGradient id="caseGrad-black" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B5563"/>
                                        <stop offset="35%" stop-color="#1F2937"/>
                                        <stop offset="75%" stop-color="#0F172A"/>
                                        <stop offset="100%" stop-color="#030712"/>
                                    </linearGradient>
                                    <linearGradient id="caseGrad-rosegold" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#FFE4E1"/>
                                        <stop offset="35%" stop-color="#E8A598"/>
                                        <stop offset="70%" stop-color="#B76E79"/>
                                        <stop offset="100%" stop-color="#5E2F37"/>
                                    </linearGradient>

                                    <!-- Dial Gradients -->
                                    <radialGradient id="dialGrad-black" cx="50%" cy="50%" r="50%">
                                        <stop offset="0%" stop-color="#222222"/>
                                        <stop offset="65%" stop-color="#0B0B0B"/>
                                        <stop offset="100%" stop-color="#020202"/>
                                    </radialGradient>
                                    <radialGradient id="dialGrad-white" cx="50%" cy="50%" r="50%">
                                        <stop offset="0%" stop-color="#FFFFFF"/>
                                        <stop offset="70%" stop-color="#F1F5F9"/>
                                        <stop offset="100%" stop-color="#CBD5E1"/>
                                    </radialGradient>

                                    <!-- Sapphire Crystal Reflection -->
                                    <linearGradient id="crystalGlare" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="rgba(255,255,255,0.18)"/>
                                        <stop offset="45%" stop-color="rgba(255,255,255,0.02)"/>
                                        <stop offset="50%" stop-color="rgba(255,255,255,0)"/>
                                    </linearGradient>

                                    <!-- Circular Clip Path for Custom Uploaded Dial Photo -->
                                    <clipPath id="dialPhotoClip">
                                        <circle cx="200" cy="270" r="112" />
                                    </clipPath>
                                </defs>

                                <!-- TOP & BOTTOM STRAPS -->
                                <g id="strapLayer">
                                    <!-- Top Strap Base -->
                                    <path id="topStrapPath" d="M132,20 L268,20 L278,125 L122,125 Z" fill="#111111" stroke="rgba(255,215,0,0.2)" stroke-width="1.5"/>
                                    <!-- Bottom Strap Base -->
                                    <path id="bottomStrapPath" d="M122,415 L278,415 L268,520 L132,520 Z" fill="#111111" stroke="rgba(255,215,0,0.2)" stroke-width="1.5"/>
                                    <!-- Dynamic Strap Texture Overlay (Leather Stitching / Metal Links / Rubber Ribs) -->
                                    <g id="strapTextureGroup"></g>
                                </g>

                                <!-- WINDING CROWN (Right Side) -->
                                <g id="crownGroup">
                                    <rect id="crownNeck" x="350" y="256" width="8" height="28" rx="2" fill="url(#caseGrad-gold)" />
                                    <rect id="crownBody" x="356" y="248" width="16" height="44" rx="4" fill="url(#caseGrad-gold)" stroke="#222" stroke-width="0.8"/>
                                    <line x1="358" y1="255" x2="370" y2="255" stroke="rgba(0,0,0,0.45)" stroke-width="1.5"/>
                                    <line x1="358" y1="262" x2="370" y2="262" stroke="rgba(0,0,0,0.45)" stroke-width="1.5"/>
                                    <line x1="358" y1="270" x2="370" y2="270" stroke="rgba(0,0,0,0.45)" stroke-width="1.5"/>
                                    <line x1="358" y1="278" x2="370" y2="278" stroke="rgba(0,0,0,0.45)" stroke-width="1.5"/>
                                    <line x1="358" y1="285" x2="370" y2="285" stroke="rgba(0,0,0,0.45)" stroke-width="1.5"/>
                                </g>

                                <!-- TONNEAU INTEGRATED WATCH CASE BODY -->
                                <path id="watchCaseOuter" d="M115,115 L285,115 L335,195 L348,270 L335,345 L285,425 L115,425 L65,345 L52,270 L65,195 Z" fill="url(#caseGrad-gold)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
                                
                                <!-- Outer Bezel Ring -->
                                <circle id="watchBezelOuter" cx="200" cy="270" r="130" fill="url(#caseGrad-gold)" stroke="rgba(0,0,0,0.35)" stroke-width="2"/>
                                <circle id="watchBezelInner" cx="200" cy="270" r="116" fill="#090909" stroke="url(#caseGrad-gold)" stroke-width="3"/>

                                <!-- MAIN WATCH DIAL (Black or White) -->
                                <circle id="watchDialBase" cx="200" cy="270" r="112" fill="url(#dialGrad-white)"/>

                                <!-- CUSTOM UPLOADED DIAL PHOTO (Clipped to exact Circular Dial Shape) -->
                                <g clip-path="url(#dialPhotoClip)">
                                    <image id="customDialImage" href="" x="88" y="158" width="224" height="224" preserveAspectRatio="xMidYMid slice" class="hidden"/>
                                    <circle id="customPhotoDimmer" cx="200" cy="270" r="112" fill="rgba(0,0,0,0.25)" class="hidden"/>
                                </g>

                                <!-- DIAL MINUTE TRACK & HOUR INDICES -->
                                <g id="dialIndicesGroup"></g>

                                <!-- COMPULSORY "DYNAST" LOGO IN CINZEL DECORATIVE FONT (Top of Dial) -->
                                <g id="compulsoryBrandGroup">
                                    <!-- Mini Royal Crown Icon -->
                                    <path id="dialCrownIcon" d="M192,202 L195,195 L200,200 L205,195 L208,202 Z" fill="#B8860B"/>
                                    <text id="dialBrandLogo" x="200" y="219" text-anchor="middle" font-family="'Cinzel Decorative', cursive" font-weight="700" font-size="16" letter-spacing="3.5" fill="#111111">DYNAST</text>
                                    <text id="dialSubBrand" x="200" y="229" text-anchor="middle" font-family="'Cinzel', serif" font-size="6.5" letter-spacing="2.5" fill="#B8860B">BESPOKE LUXURY</text>
                                </g>

                                <!-- CUSTOMER CUSTOM NAME ON DIAL -->
                                <g id="customDialNameGroup">
                                    <text id="svgCustomName" x="200" y="324" text-anchor="middle" font-family="'Cinzel', serif" font-weight="600" font-size="14" letter-spacing="1.8" fill="#111111">Hanzalah</text>
                                    <line id="svgCustomNameLine" x1="172" y1="331" x2="228" y2="331" stroke="#B8860B" stroke-width="0.9" opacity="0.8"/>
                                </g>

                                <!-- ANALOG WATCH HANDS (Hour, Minute, Second) -->
                                <g id="watchHandsGroup">
                                    <!-- Hour Hand -->
                                    <g id="hourHand" transform="rotate(300, 200, 270)">
                                        <polygon points="196,270 198,195 200,186 202,195 204,270" fill="#B8860B" stroke="#111" stroke-width="0.6"/>
                                    </g>
                                    <!-- Minute Hand -->
                                    <g id="minuteHand" transform="rotate(60, 200, 270)">
                                        <polygon points="197,270 198.5,172 200,164 201.5,172 203,270" fill="#B8860B" stroke="#111" stroke-width="0.6"/>
                                    </g>
                                    <!-- Second Hand -->
                                    <g id="secondHand" transform="rotate(180, 200, 270)">
                                        <line x1="200" y1="292" x2="200" y2="162" stroke="#D97706" stroke-width="1.4"/>
                                        <circle cx="200" cy="270" r="5" fill="#B8860B" stroke="#000" stroke-width="1"/>
                                    </g>
                                </g>

                                <!-- SAPPHIRE GLASS GLARE OVERLAY -->
                                <circle cx="200" cy="270" r="112" fill="url(#crystalGlare)" pointer-events="none"/>
                            </svg>
                            <span class="text-[11px] text-gold/80 uppercase tracking-widest mt-1 font-medium">Front Dial & Strap Preview</span>
                        </div>
                        <!-- 2. BACK CASE (COVER) SVG RENDERER (MATCHING UPLOADED PHOTOS) -->
                        <div id="backWatchWrapper" class="w-full flex flex-col items-center hidden">
                            <svg id="backWatchSvg" viewBox="0 0 400 540" class="w-full max-w-[310px] drop-shadow-[0_25px_35px_rgba(0,0,0,0.95)] select-none">
                                <!-- Top & Bottom Straps (Back View) -->
                                <path id="backTopStrap" d="M132,20 L268,20 L278,125 L122,125 Z" fill="#111111"/>
                                <path id="backBottomStrap" d="M122,415 L278,415 L268,520 L132,520 Z" fill="#111111"/>

                                <!-- Crown on Left Side (Reversed for Back View, matching photos) -->
                                <rect id="backCrownBody" x="28" y="248" width="16" height="44" rx="4" fill="url(#caseGrad-silver)" stroke="#222" stroke-width="0.8"/>
                                <rect id="backCrownNeck" x="44" y="256" width="8" height="28" rx="2" fill="url(#caseGrad-silver)"/>

                                <!-- Tonneau Back Case Outer Body (Matching Tissot PRX Caseback Silhouette) -->
                                <path id="backCaseBody" d="M115,115 L155,115 L155,130 L245,130 L245,115 L285,115 L335,195 L348,270 L335,345 L285,425 L245,425 L245,410 L155,410 L155,425 L115,425 L65,345 L52,270 L65,195 Z" fill="url(#caseGrad-silver)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>

                                <!-- Outer Caseback Bevel Ring -->
                                <circle cx="200" cy="270" r="126" fill="url(#caseGrad-silver)" stroke="rgba(0,0,0,0.4)" stroke-width="2"/>
                                <circle cx="200" cy="270" r="112" fill="#CBD5E1" stroke="rgba(0,0,0,0.3)" stroke-width="1.5"/>

                                <!-- Curved Perimeter Paths for Caseback Engravings -->
                                <defs>
                                    <path id="topArcPath" d="M 102,270 A 98,98 0 1,1 298,270" />
                                    <path id="bottomArcPath" d="M 298,270 A 98,98 0 1,1 102,270" />
                                </defs>

                                <!-- OPTION A: SOLID BRUSHED STAINLESS STEEL CASEBACK (Photo 1) -->
                                <g id="solidBackGroup">
                                    <circle cx="200" cy="270" r="90" fill="url(#caseGrad-silver)" stroke="rgba(255,255,255,0.5)" stroke-width="1"/>
                                    <circle cx="200" cy="270" r="65" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="25"/>
                                    <text x="200" y="265" text-anchor="middle" font-family="'Cinzel Decorative', cursive" font-size="15" font-weight="700" fill="rgba(0,0,0,0.55)" letter-spacing="3">DYNAST</text>
                                    <text id="backCustomEngravingText" x="200" y="285" text-anchor="middle" font-family="'Cinzel', serif" font-size="8.5" fill="rgba(0,0,0,0.65)" letter-spacing="1.5">BESPOKE EDITION</text>
                                </g>

                                <!-- OPTION B: EXHIBITION TRANSPARENT SKELETON CASEBACK (Photo 2) -->
                                <g id="skeletonBackGroup" class="hidden">
                                    <!-- Dark Mechanical Movement Cavern -->
                                    <circle cx="200" cy="270" r="86" fill="#18181B" stroke="#475569" stroke-width="3"/>
                                    
                                    <!-- Inner Movement Bridges & Gears -->
                                    <circle cx="200" cy="270" r="76" fill="#94A3B8" opacity="0.25"/>
                                    <!-- Golden Gear Wheels -->
                                    <circle cx="175" cy="235" r="22" fill="none" stroke="#D4AF37" stroke-width="4" stroke-dasharray="4 3"/>
                                    <circle cx="228" cy="245" r="16" fill="none" stroke="#D4AF37" stroke-width="3.5" stroke-dasharray="3 2"/>
                                    
                                    <!-- Animated Balance Wheel at Top (12 o'clock) -->
                                    <g class="balance-wheel-anim">
                                        <circle cx="200" cy="215" r="18" fill="none" stroke="#FFD700" stroke-width="3"/>
                                        <line x1="182" y1="215" x2="218" y2="215" stroke="#FFD700" stroke-width="2"/>
                                        <line x1="200" y1="197" x2="200" y2="233" stroke="#FFD700" stroke-width="2"/>
                                    </g>
                                    <!-- Synthetic Ruby Jewels (Pink/Red) -->
                                    <circle cx="200" cy="215" r="4" fill="#E11D48" stroke="#FFD700" stroke-width="1"/>
                                    <circle cx="170" cy="248" r="3.5" fill="#E11D48"/>
                                    <circle cx="228" cy="245" r="3.5" fill="#E11D48"/>

                                    <!-- Skeleton Automatic Oscillating Rotor (Bottom Half, matching Photo 2) -->
                                    <path d="M116,270 A84,84 0 0,0 284,270 L245,270 L230,295 L170,295 L155,270 Z" fill="url(#caseGrad-silver)" stroke="#475569" stroke-width="1.5"/>
                                    <!-- Rotor Central Ball Bearing -->
                                    <circle cx="200" cy="270" r="18" fill="#E2E8F0" stroke="#475569" stroke-width="1.5"/>
                                    <circle cx="200" cy="270" r="8" fill="#D4AF37" stroke="#1E293B" stroke-width="1.5"/>
                                    
                                    <!-- Rotor Custom DYNAST Engraving -->
                                    <rect x="166" y="303" width="68" height="24" rx="2" fill="rgba(255,255,255,0.35)" stroke="#64748B" stroke-width="0.8"/>
                                    <text x="200" y="315" text-anchor="middle" font-family="'Cinzel Decorative', cursive" font-size="9.5" font-weight="700" fill="#111827" letter-spacing="1.5">DYNAST</text>
                                    <text x="200" y="324" text-anchor="middle" font-family="'Inter', sans-serif" font-size="5.5" font-weight="600" fill="#1F2937" letter-spacing="1">1853 • BESPOKE</text>
                                    <text x="200" y="344" text-anchor="middle" font-family="'Inter', sans-serif" font-size="5.2" fill="#334155" letter-spacing="0.8">HIGH-TECH ESCAPEMENT • 23 JEWELS</text>
                                </g>

                                <!-- Perimeter Engravings (Common to Both Back Cases, matching Photos) -->
                                <text x="200" y="168" text-anchor="middle" font-family="'Cinzel Decorative', cursive" font-size="8.5" font-weight="700" fill="#1E293B" letter-spacing="1.5">DYNAST</text>
                                <text font-family="'Inter', sans-serif" font-size="6.5" font-weight="600" fill="#334155" letter-spacing="1.4">
                                    <textPath href="#topArcPath" startOffset="12%">SAPPHIRE CRYSTAL</textPath>
                                    <textPath href="#topArcPath" startOffset="62%">STAINLESS STEEL •</textPath>
                                    <textPath href="#bottomArcPath" startOffset="18%">WATER-RESISTANT 10bar (100m/330ft)</textPath>
                                </text>

                                <!-- Strap Lock / Clasp Badge Indicator at Bottom of Back Strap -->
                                <g id="backClaspBadge" transform="translate(145, 450)">
                                    <rect width="110" height="34" rx="6" fill="url(#caseGrad-silver)" stroke="#111" stroke-width="1"/>
                                    <text x="55" y="15" text-anchor="middle" font-family="'Cinzel Decorative', cursive" font-size="7" fill="#000" font-weight="700">DYNAST</text>
                                    <text id="svgClaspLabel" x="55" y="26" text-anchor="middle" font-family="'Inter', sans-serif" font-size="6" fill="#111" font-weight="600">BUTTERFLY CLASP</text>
                                </g>
                            </svg>
                            <span id="backCaseCaption" class="text-[11px] text-gold/80 uppercase tracking-widest mt-1 font-medium">Solid Brushed Steel Caseback</span>
                        </div>
                    </div>

