    <!-- COMPLETE JAVASCRIPT ENGINE -->
    <script>
        // 1. PRICING & OPTIONS CATALOG
        const BASE_WATCH_PRICE = 2999;

        const CASE_OPTIONS = {
            gold:     { name: 'Royal Golden Case', price: 1500, grad: 'url(#caseGrad-gold)', accent: '#B8860B' },
            black:    { name: 'Obsidian Black Case', price: 1200, grad: 'url(#caseGrad-black)', accent: '#374151' },
            silver:   { name: 'Brushed Silver Case', price: 0, grad: 'url(#caseGrad-silver)', accent: '#64748B' },
            rosegold: { name: 'Imperial Rose-Gold Case', price: 1600, grad: 'url(#caseGrad-rosegold)', accent: '#B76E79' }
        };

        const DIAL_OPTIONS = {
            white: { name: 'Porcelain White Dial', price: 300, grad: 'url(#dialGrad-white)', defaultText: '#111111' },
            black: { name: 'Obsidian Black Dial', price: 0, grad: 'url(#dialGrad-black)', defaultText: '#FFD700' }
        };

        const BACK_CASE_OPTIONS = {
            solid:    { name: 'Solid Brushed Steel Cover', price: 0 },
            skeleton: { name: 'Exhibition Sapphire Skeleton Cover', price: 2200 }
        };

        const STRAP_MATERIALS = {
            leather: {
                name: 'Italian Leather', price: 600,
                colors: [
                    { id: 'pitch-black', name: 'Pitch Black Leather', hex: '#121212', stitch: '#D4AF37', price: 0 },
                    { id: 'espresso-brown', name: 'Royal Espresso Brown', hex: '#3E2723', stitch: '#E5B85B', price: 150 },
                    { id: 'cognac-tan', name: 'Vintage Cognac Tan', hex: '#7C3F1D', stitch: '#FDE68A', price: 200 },
                    { id: 'burgundy', name: 'Burgundy Wine Leather', hex: '#4A121A', stitch: '#FFD700', price: 200 },
                    { id: 'midnight-navy', name: 'Midnight Navy Leather', hex: '#112239', stitch: '#E2E8F0', price: 150 }
                ]
            },
            metal: {
                name: 'Metal Bracelet', price: 1400,
                colors: [
                    { id: 'metal-silver', name: 'Brushed Steel Silver', hex: '#CBD5E1', linkLine: '#475569', price: 0 },
                    { id: 'metal-gold', name: 'Royal Gold Bracelet', hex: '#D4AF37', linkLine: '#5A3E04', price: 500 },
                    { id: 'metal-black', name: 'Matte Black PVD Metal', hex: '#18181B', linkLine: '#000000', price: 400 },
                    { id: 'metal-rosegold', name: 'Rose-Gold Bracelet', hex: '#D8968B', linkLine: '#5E2F37', price: 500 }
                ]
            },
            rubber: {
                name: 'Sport Rubber', price: 500,
                colors: [
                    { id: 'rubber-black', name: 'Stealth Black Rubber', hex: '#171717', price: 0 },
                    { id: 'rubber-red', name: 'Racing Crimson Red', hex: '#7F1D1D', price: 150 },
                    { id: 'rubber-blue', name: 'Deep Ocean Blue', hex: '#1E3A8A', price: 150 },
                    { id: 'rubber-olive', name: 'Tactical Olive Green', hex: '#2E3B2F', price: 150 }
                ]
            },
            silicone: {
                name: 'Soft Silicone', price: 350,
                colors: [
                    { id: 'sil-black', name: 'Matte Black Silicone', hex: '#1C1C1E', price: 0 },
                    { id: 'sil-emerald', name: 'Royal Emerald Silicone', hex: '#064E3B', price: 100 },
                    { id: 'sil-sand', name: 'Desert Sand Beige', hex: '#A8997E', price: 100 },
                    { id: 'sil-slate', name: 'Arctic Slate Grey', hex: '#475569', price: 100 }
                ]
            }
        };

        const STRAP_LOCKS = {
            buckle:    { name: 'Classic Tang Pin Buckle', price: 0, badge: 'CLASSIC BUCKLE' },
            butterfly: { name: 'Butterfly Deployant Lock', price: 650, badge: 'BUTTERFLY CLASP' },
            folding:   { name: 'Folding Safety Clasp', price: 500, badge: 'SAFETY FOLD LOCK' },
            magnetic:  { name: 'Magnetic Luxury Clasp', price: 800, badge: 'MAGNETIC LOCK' }
        };

        // 2. CURRENT WATCH CUSTOMIZATION STATE
        let state = {
            caseColor: 'gold',
            dialColor: 'white',
            customName: 'Hanzalah',
            customNameFont: "'Cinzel', serif",
            customNameColor: '#111111',
            customPhotoDataUrl: null,
            photoZoom: 100,
            photoOffsetX: 0,
            photoOffsetY: 0,
            photoDimmer: 25,
            backCase: 'solid',
            strapMaterial: 'leather',
            strapColorIndex: 0,
            strapLock: 'butterfly',
            viewMode: 'front'
        };

        let authMode = 'login';
        let currentUser = JSON.parse(localStorage.getItem('dynast_current_user') || 'null');

        // 3. INITIALIZE STUDIO
        window.addEventListener('DOMContentLoaded', () => {
            buildDialIndices();
            renderStrapColorSwatches();
            renderWatch();
            updateAuthUI();
            startLiveWatchHands();
        });

        function buildDialIndices() {
            const group = document.getElementById('dialIndicesGroup');
            let html = '';
            for (let i = 0; i < 60; i++) {
                const angle = i * 6;
                const isHour = i % 5 === 0;
                if (isHour) {
                    const width = (i === 0) ? 4 : 2.5;
                    const len = (i === 0) ? 14 : 10;
                    html += `<rect x="${200 - width/2}" y="162" width="${width}" height="${len}" rx="1" fill="#B8860B" transform="rotate(${angle}, 200, 270)"/>`;
                } else {
                    html += `<line x1="200" y1="162" x2="200" y2="166" stroke="rgba(184,134,11,0.55)" stroke-width="1" transform="rotate(${angle}, 200, 270)"/>`;
                }
            }
            group.innerHTML = html;
        }

        function startLiveWatchHands() {
            function tick() {
                const now = new Date();
                const sec = now.getSeconds();
                const min = now.getMinutes();
                const hr = now.getHours() % 12;
                document.getElementById('secondHand').setAttribute('transform', `rotate(${sec * 6}, 200, 270)`);
                document.getElementById('minuteHand').setAttribute('transform', `rotate(${min * 6 + sec * 0.1}, 200, 270)`);
                document.getElementById('hourHand').setAttribute('transform', `rotate(${hr * 30 + min * 0.5}, 200, 270)`);
            }
            tick();
            setInterval(tick, 1000);
        }

        // 4. SELECTION HANDLERS
        function selectCaseColor(colorKey) {
            state.caseColor = colorKey;
            document.querySelectorAll('#caseColorGrid .option-card').forEach(el => el.classList.remove('active'));
            document.getElementById(`caseBtn-${colorKey}`).classList.add('active');
            const p = CASE_OPTIONS[colorKey].price;
            document.getElementById('step1PriceBadge').textContent = p === 0 ? 'Included (+₹0)' : `+₹${p.toLocaleString('en-IN')}`;
            renderWatch();
        }

        function selectDialColor(dialKey) {
            state.dialColor = dialKey;
            document.getElementById('dialBtn-white').classList.toggle('active', dialKey === 'white');
            document.getElementById('dialBtn-black').classList.toggle('active', dialKey === 'black');
            state.customNameColor = dialKey === 'white' ? '#111111' : '#FFD700';
            renderWatch();
        }

        function updateCustomNameFromInput() {
            state.customName = document.getElementById('customNameInput').value;
            renderWatch();
        }

        function clearCustomName() {
            state.customName = '';
            document.getElementById('customNameInput').value = '';
            renderWatch();
        }

        function setCustomNameColor(hex) {
            state.customNameColor = hex;
            renderWatch();
        }

        function handleDialPhotoUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                state.customPhotoDataUrl = e.target.result;
                document.getElementById('removePhotoBtn').classList.remove('hidden');
                document.getElementById('photoAdjustControls').classList.remove('hidden');
                renderWatch();
            };
            reader.readAsDataURL(file);
        }

        function updatePhotoTransform() {
            state.photoZoom = parseInt(document.getElementById('photoZoom').value, 10);
            state.photoOffsetX = parseInt(document.getElementById('photoOffsetX').value, 10);
            state.photoOffsetY = parseInt(document.getElementById('photoOffsetY').value, 10);
            state.photoDimmer = parseInt(document.getElementById('photoDimmerRange').value, 10);
            document.getElementById('zoomVal').textContent = `${state.photoZoom}%`;
            renderWatch();
        }

        function removeDialPhoto() {
            state.customPhotoDataUrl = null;
            document.getElementById('dialPhotoInput').value = '';
            document.getElementById('removePhotoBtn').classList.add('hidden');
            document.getElementById('photoAdjustControls').classList.add('hidden');
            renderWatch();
        }

        function selectBackCase(typeKey) {
            state.backCase = typeKey;
            document.getElementById('backBtn-solid').classList.toggle('active', typeKey === 'solid');
            document.getElementById('backBtn-skeleton').classList.toggle('active', typeKey === 'skeleton');
            setWatchView('back');
            renderWatch();
        }

        function selectStrapMaterial(matKey) {
            state.strapMaterial = matKey;
            state.strapColorIndex = 0;
            ['leather', 'metal', 'rubber', 'silicone'].forEach(k => {
                document.getElementById(`strapMat-${k}`).classList.toggle('active', k === matKey);
            });
            document.getElementById('currentStrapMatLabel').textContent = STRAP_MATERIALS[matKey].name;
            renderStrapColorSwatches();
            renderWatch();
        }

        function renderStrapColorSwatches() {
            const mat = STRAP_MATERIALS[state.strapMaterial];
            const container = document.getElementById('strapColorsContainer');
            container.innerHTML = mat.colors.map((c, idx) => `
                <button onclick="selectStrapColor(${idx})" class="swatch-btn ${idx === state.strapColorIndex ? 'active' : ''} flex items-center gap-2 px-3 py-2 rounded-xl bg-black/70 border border-gold/30 text-xs">
                    <span class="w-5 h-5 rounded-full border border-white/30" style="background:${c.hex}"></span>
                    <span class="text-white font-medium">${c.name}</span>
                    <span class="text-[10px] text-gold">${c.price === 0 ? '+₹0' : '+₹' + c.price}</span>
                </button>
            `).join('');
        }

        function selectStrapColor(index) {
            state.strapColorIndex = index;
            renderStrapColorSwatches();
            renderWatch();
        }

        function selectStrapLock(lockKey) {
            state.strapLock = lockKey;
            ['buckle', 'butterfly', 'folding', 'magnetic'].forEach(k => {
                document.getElementById(`lockBtn-${k}`).classList.toggle('active', k === lockKey);
            });
            renderWatch();
        }

        function setWatchView(mode) {
            state.viewMode = mode;
            const frontWrap = document.getElementById('frontWatchWrapper');
            const backWrap = document.getElementById('backWatchWrapper');
            const stage = document.getElementById('watchStageContainer');

            ['Front', 'Back', 'Split'].forEach(m => {
                const btn = document.getElementById(`view${m}Btn`);
                const active = m.toLowerCase() === mode;
                btn.className = active ? 'px-2.5 py-1 rounded-lg bg-gold text-black font-bold transition' : 'px-2.5 py-1 rounded-lg text-gray-300 hover:text-gold transition';
            });

            if (mode === 'front') {
                stage.className = 'grid grid-cols-1 gap-4 items-center justify-items-center py-2';
                frontWrap.classList.remove('hidden');
                backWrap.classList.add('hidden');
            } else if (mode === 'back') {
                stage.className = 'grid grid-cols-1 gap-4 items-center justify-items-center py-2';
                frontWrap.classList.add('hidden');
                backWrap.classList.remove('hidden');
            } else {
                stage.className = 'grid grid-cols-1 sm:grid-cols-2 gap-4 items-center justify-items-center py-2';
                frontWrap.classList.remove('hidden');
                backWrap.classList.remove('hidden');
            }
        }

        // 5. MASTER RENDER ENGINE (UPDATES SVG & PRICE TAGS LIVE)
        function renderWatch() {
            const caseObj = CASE_OPTIONS[state.caseColor];
            const dialObj = DIAL_OPTIONS[state.dialColor];
            const matObj = STRAP_MATERIALS[state.strapMaterial];
            const strapColorObj = matObj.colors[state.strapColorIndex] || matObj.colors[0];
            const lockObj = STRAP_LOCKS[state.strapLock];
            const backObj = BACK_CASE_OPTIONS[state.backCase];

            // Update Case Gradients (Front & Back)
            ['watchCaseOuter', 'watchBezelOuter', 'crownNeck', 'crownBody', 'backCaseBody', 'backCrownBody', 'backCrownNeck'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.setAttribute('fill', caseObj.grad);
            });
            document.getElementById('watchBezelInner').setAttribute('stroke', caseObj.grad);

            // Update Dial Base
            document.getElementById('watchDialBase').setAttribute('fill', dialObj.grad);

            // Compulsory DYNAST Logo Contrast
            const logoFill = (state.dialColor === 'white' && !state.customPhotoDataUrl) ? '#090909' : '#FFE87C';
            document.getElementById('dialBrandLogo').setAttribute('fill', logoFill);

            // Custom Photo Rendering inside Circular Dial ClipPath
            const imgEl = document.getElementById('customDialImage');
            const dimmerEl = document.getElementById('customPhotoDimmer');
            if (state.customPhotoDataUrl) {
                imgEl.setAttribute('href', state.customPhotoDataUrl);
                const size = 224 * (state.photoZoom / 100);
                const x = 200 - (size / 2) + state.photoOffsetX;
                const y = 270 - (size / 2) + state.photoOffsetY;
                imgEl.setAttribute('width', size);
                imgEl.setAttribute('height', size);
                imgEl.setAttribute('x', x);
                imgEl.setAttribute('y', y);
                imgEl.classList.remove('hidden');
                dimmerEl.setAttribute('fill', `rgba(0,0,0,${state.photoDimmer / 100})`);
                dimmerEl.classList.remove('hidden');
            } else {
                imgEl.classList.add('hidden');
                dimmerEl.classList.add('hidden');
            }

            // Custom Name Rendering on Dial
            const nameEl = document.getElementById('svgCustomName');
            const lineEl = document.getElementById('svgCustomNameLine');
            const fontSelect = document.getElementById('customNameFont');
            if (fontSelect) state.customNameFont = fontSelect.value;

            if (state.customName && state.customName.trim() !== '') {
                nameEl.textContent = state.customName.trim();
                nameEl.setAttribute('font-family', state.customNameFont);
                nameEl.setAttribute('fill', state.customNameColor);
                lineEl.classList.remove('hidden');
                document.getElementById('backCustomEngravingText').textContent = `CRAFTED FOR ${state.customName.trim().toUpperCase()}`;
            } else {
                nameEl.textContent = '';
                lineEl.classList.add('hidden');
                document.getElementById('backCustomEngravingText').textContent = 'BESPOKE EDITION';
            }

            // Update Straps & Textures
            ['topStrapPath', 'bottomStrapPath', 'backTopStrap', 'backBottomStrap'].forEach(id => {
                document.getElementById(id).setAttribute('fill', strapColorObj.hex);
            });
            document.getElementById('selectedStrapColorName').textContent = `${strapColorObj.name} (${strapColorObj.price === 0 ? '+₹0' : '+₹' + strapColorObj.price})`;

            const texGroup = document.getElementById('strapTextureGroup');
            if (state.strapMaterial === 'leather') {
                const st = strapColorObj.stitch || '#D4AF37';
                texGroup.innerHTML = `
                    <line x1="138" y1="26" x2="130" y2="118" stroke="${st}" stroke-width="1.3" stroke-dasharray="4 3"/>
                    <line x1="262" y1="26" x2="270" y2="118" stroke="${st}" stroke-width="1.3" stroke-dasharray="4 3"/>
                    <line x1="130" y1="422" x2="138" y2="514" stroke="${st}" stroke-width="1.3" stroke-dasharray="4 3"/>
                    <line x1="270" y1="422" x2="262" y2="514" stroke="${st}" stroke-width="1.3" stroke-dasharray="4 3"/>
                `;
            } else if (state.strapMaterial === 'metal') {
                const ln = strapColorObj.linkLine || '#333';
                texGroup.innerHTML = `
                    <line x1="128" y1="45" x2="272" y2="45" stroke="${ln}" stroke-width="2"/>
                    <line x1="126" y1="70" x2="274" y2="70" stroke="${ln}" stroke-width="2"/>
                    <line x1="124" y1="95" x2="276" y2="95" stroke="${ln}" stroke-width="2"/>
                    <line x1="175" y1="20" x2="175" y2="125" stroke="${ln}" stroke-width="1.5"/>
                    <line x1="225" y1="20" x2="225" y2="125" stroke="${ln}" stroke-width="1.5"/>
                    <line x1="124" y1="445" x2="276" y2="445" stroke="${ln}" stroke-width="2"/>
                    <line x1="126" y1="470" x2="274" y2="470" stroke="${ln}" stroke-width="2"/>
                    <line x1="128" y1="495" x2="272" y2="495" stroke="${ln}" stroke-width="2"/>
                    <line x1="175" y1="415" x2="175" y2="520" stroke="${ln}" stroke-width="1.5"/>
                    <line x1="225" y1="415" x2="225" y2="520" stroke="${ln}" stroke-width="1.5"/>
                `;
            } else if (state.strapMaterial === 'rubber' || state.strapMaterial === 'silicone') {
                texGroup.innerHTML = `
                    <rect x="148" y="35" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                    <rect x="148" y="60" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                    <rect x="148" y="85" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                    <rect x="148" y="438" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                    <rect x="148" y="463" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                    <rect x="148" y="488" width="104" height="8" rx="4" fill="rgba(0,0,0,0.35)"/>
                `;
            }

            // Update Back Case Type (Solid vs Skeleton)
            document.getElementById('solidBackGroup').classList.toggle('hidden', state.backCase !== 'solid');
            document.getElementById('skeletonBackGroup').classList.toggle('hidden', state.backCase !== 'skeleton');
            document.getElementById('backCaseCaption').textContent = backObj.name;
            document.getElementById('svgClaspLabel').textContent = lockObj.badge;

            // Calculate Live Itemized Price Breakdown
            const hasName = state.customName && state.customName.trim() !== '';
            const namePrice = hasName ? 499 : 0;
            const photoPrice = state.customPhotoDataUrl ? 999 : 0;

            const items = [
                { label: 'Base DYNAST Bespoke Timepiece', price: BASE_WATCH_PRICE },
                { label: caseObj.name, price: caseObj.price },
                { label: dialObj.name, price: dialObj.price },
                { label: hasName ? `Custom Dial Name ("${state.customName.trim()}")` : 'Custom Dial Name (None)', price: namePrice },
                { label: state.customPhotoDataUrl ? 'Custom Circular Dial Picture Print' : 'Custom Dial Picture (None)', price: photoPrice },
                { label: backObj.name, price: backObj.price },
                { label: `${matObj.name} (${strapColorObj.name})`, price: matObj.price + strapColorObj.price },
                { label: lockObj.name, price: lockObj.price }
            ];

            const total = items.reduce((sum, i) => sum + i.price, 0);
            state.totalPrice = total;

            document.getElementById('priceBreakdownList').innerHTML = items.map(item => `
                <div class="flex justify-between items-center">
                    <span>${item.label}</span>
                    <span class="font-semibold ${item.price > 0 ? 'text-gold' : 'text-gray-400'}">${item.price === 0 ? 'Included' : '₹' + item.price.toLocaleString('en-IN')}</span>
                </div>
            `).join('');

            const formattedTotal = `₹${total.toLocaleString('en-IN')}`;
            document.getElementById('navTotalPrice').textContent = formattedTotal;
            document.getElementById('cardTotalPrice').textContent = formattedTotal;
        }

        function applyHanzalahPreset() {
            state.caseColor = 'gold';
            state.dialColor = 'white';
            state.customName = 'Hanzalah';
            state.customNameColor = '#111111';
            document.getElementById('customNameInput').value = 'Hanzalah';
            setWatchView('front');
            selectCaseColor('gold');
            selectDialColor('white');
        }

        // 6. CUSTOMER AUTHENTICATION, CUSTOMIZATION HISTORY & PREVIOUS ORDERS
        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        function handleAuthButtonClick() {
            if (currentUser) {
                openAccountModal('history');
            } else {
                openModal('authModal');
            }
        }

        function switchAuthTab(mode) {
            authMode = mode;
            document.getElementById('tabLoginBtn').className = mode === 'login' ? 'py-2 rounded-lg bg-gold text-black font-bold' : 'py-2 rounded-lg text-gray-300 hover:text-gold';
            document.getElementById('tabSignupBtn').className = mode === 'signup' ? 'py-2 rounded-lg bg-gold text-black font-bold' : 'py-2 rounded-lg text-gray-300 hover:text-gold';
            document.getElementById('signupNameField').classList.toggle('hidden', mode !== 'signup');
            document.getElementById('signupPhoneField').classList.toggle('hidden', mode !== 'signup');
            document.getElementById('authSubmitBtn').textContent = mode === 'login' ? 'Sign In to Studio' : 'Create Bespoke Account';
            document.getElementById('authErrorMsg').classList.add('hidden');
        }

        function submitAuthForm(e) {
            e.preventDefault();
            const email = document.getElementById('authEmail').value.trim().toLowerCase();
            const password = document.getElementById('authPassword').value;
            const users = JSON.parse(localStorage.getItem('dynast_users') || '{}');

            if (authMode === 'signup') {
                const name = document.getElementById('authName').value.trim() || 'DYNAST Collector';
                const phone = document.getElementById('authPhone').value.trim();
                users[email] = { name, email, phone, password };
                localStorage.setItem('dynast_users', JSON.stringify(users));
                currentUser = { name, email, phone };
            } else {
                if (!users[email] || users[email].password !== password) {
                    const err = document.getElementById('authErrorMsg');
                    err.textContent = 'Invalid email or password. Or switch to "Create Account" first.';
                    err.classList.remove('hidden');
                    return;
                }
                currentUser = { name: users[email].name, email, phone: users[email].phone };
            }

            localStorage.setItem('dynast_current_user', JSON.stringify(currentUser));
            closeModal('authModal');
            updateAuthUI();
            openAccountModal('history');
        }

        function logoutCustomer() {
            currentUser = null;
            localStorage.removeItem('dynast_current_user');
            updateAuthUI();
            closeModal('accountModal');
        }

        function getStorageKey(type) {
            const emailKey = currentUser ? currentUser.email : 'guest';
            return `dynast_${type}_${emailKey}`;
        }

        function updateAuthUI() {
            const historyList = JSON.parse(localStorage.getItem(getStorageKey('history')) || '[]');
            const ordersList = JSON.parse(localStorage.getItem(getStorageKey('orders')) || '[]');
            document.getElementById('historyCountBadge').textContent = historyList.length + ordersList.length;

            if (currentUser) {
                document.getElementById('authNavText').textContent = currentUser.name.split(' ')[0];
                document.getElementById('accountUserName').textContent = currentUser.name;
                document.getElementById('accountUserEmail').textContent = `${currentUser.email} • ${currentUser.phone || ''}`;
                document.getElementById('accountAvatar').textContent = currentUser.name.charAt(0).toUpperCase();
                document.getElementById('logoutBtn').classList.remove('hidden');
            } else {
                document.getElementById('authNavText').textContent = 'Sign In';
                document.getElementById('accountUserName').textContent = 'Guest Collector';
                document.getElementById('accountUserEmail').textContent = 'Sign in to permanently save your orders & customizations';
                document.getElementById('accountAvatar').textContent = 'D';
                document.getElementById('logoutBtn').classList.add('hidden');
            }
        }

        function saveCurrentDesignToHistory() {
            const key = getStorageKey('history');
            const list = JSON.parse(localStorage.getItem(key) || '[]');
            const matObj = STRAP_MATERIALS[state.strapMaterial];
            const strapColorObj = matObj.colors[state.strapColorIndex] || matObj.colors[0];

            const entry = {
                id: 'CUST-' + Date.now().toString().slice(-5),
                date: new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }),
                summary: `${CASE_OPTIONS[state.caseColor].name} • ${DIAL_OPTIONS[state.dialColor].name} • Dial Name: "${state.customName || 'None'}" • ${BACK_CASE_OPTIONS[state.backCase].name} • ${strapColorObj.name}`,
                totalPrice: state.totalPrice,
                savedState: JSON.parse(JSON.stringify(state))
            };
            list.unshift(entry);
            localStorage.setItem(key, JSON.stringify(list.slice(0, 20)));
            updateAuthUI();
            openAccountModal('history');
        }

        function openAccountModal(tab) {
            updateAuthUI();
            openModal('accountModal');
            switchAccountTab(tab || 'history');
        }

        function switchAccountTab(tab) {
            const historyList = JSON.parse(localStorage.getItem(getStorageKey('history')) || '[]');
            const ordersList = JSON.parse(localStorage.getItem(getStorageKey('orders')) || '[]');
            document.getElementById('tabHistoryCount').textContent = historyList.length;
            document.getElementById('tabOrdersCount').textContent = ordersList.length;

            document.getElementById('accTabHistory').className = tab === 'history' ? 'px-4 py-2 rounded-xl bg-gold text-black font-bold' : 'px-4 py-2 rounded-xl bg-white/5 text-gray-300 hover:text-gold border border-gold/25';
            document.getElementById('accTabOrders').className = tab === 'orders' ? 'px-4 py-2 rounded-xl bg-gold text-black font-bold' : 'px-4 py-2 rounded-xl bg-white/5 text-gray-300 hover:text-gold border border-gold/25';

            const area = document.getElementById('accountContentArea');
            if (tab === 'history') {
                if (historyList.length === 0) {
                    area.innerHTML = `<p class="text-xs text-gray-400 text-center py-8">No saved customizations yet. Click "Save to History" on the customizer to store your watch designs!</p>`;
                    return;
                }
                area.innerHTML = historyList.map((item, idx) => `
                    <div class="p-4 rounded-2xl bg-black/70 border border-gold/30 flex flex-wrap items-center justify-between gap-3">
                        <div class="space-y-1 max-w-md">
                            <span class="text-[10px] text-gold uppercase tracking-widest">${item.id} • ${item.date}</span>
                            <p class="text-xs text-white font-semibold">${item.summary}</p>
                            <p class="text-xs text-lightgold font-bold">Total: ₹${item.totalPrice.toLocaleString('en-IN')}</p>
                        </div>
                        <button onclick="loadSavedDesign(${idx})" class="btn-gold px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider">
                            Load on Watch
                        </button>
                    </div>
                `).join('');
            } else {
                if (ordersList.length === 0) {
                    area.innerHTML = `<p class="text-xs text-gray-400 text-center py-8">You haven't placed any bespoke orders yet.</p>`;
                    return;
                }
                area.innerHTML = ordersList.map((ord) => `
                    <div class="p-4 rounded-2xl bg-black/70 border border-gold/40 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-gold">${ord.orderId} • ${ord.date}</span>
                            <span class="text-[10px] bg-green-500/20 border border-green-500/40 text-green-300 px-2.5 py-0.5 rounded-full">In Bespoke Production</span>
                        </div>
                        <p class="text-xs text-white">${ord.summary}</p>
                        <p class="text-[11px] text-gray-400">Deliver To: ${ord.customerName} (${ord.phone}) — ${ord.address}</p>
                        <div class="flex items-center justify-between pt-2 border-t border-white/10">
                            <span class="text-xs font-bold text-lightgold">Paid/Total: ₹${ord.totalPrice.toLocaleString('en-IN')}</span>
                            <a href="https://wa.me/917579942958?text=${encodeURIComponent('Hello DYNAST, checking status for my Bespoke Order ' + ord.orderId)}" target="_blank" class="text-xs text-green-400 hover:underline">
                                <i class="fa-brands fa-whatsapp mr-1"></i> Track on WhatsApp
                            </a>
                        </div>
                    </div>
                `).join('');
            }
        }

        function loadSavedDesign(index) {
            const list = JSON.parse(localStorage.getItem(getStorageKey('history')) || '[]');
            if (!list[index]) return;
            state = JSON.parse(JSON.stringify(list[index].savedState));
            document.getElementById('customNameInput').value = state.customName || '';
            selectCaseColor(state.caseColor);
            selectStrapMaterial(state.strapMaterial);
            selectStrapLock(state.strapLock);
            renderWatch();
            closeModal('accountModal');
        }

        // 7. CHECKOUT & SNAPSHOT DOWNLOADER
        function openCheckoutModal() {
            const matObj = STRAP_MATERIALS[state.strapMaterial];
            const strapColorObj = matObj.colors[state.strapColorIndex] || matObj.colors[0];
            if (currentUser) {
                document.getElementById('orderName').value = currentUser.name || '';
                document.getElementById('orderPhone').value = currentUser.phone || '';
            }
            document.getElementById('checkoutSummaryBox').innerHTML = `
                <p><strong class="text-gold">Compulsory Dial Emblem:</strong> DYNAST (Cinzel Decorative)</p>
                <p><strong class="text-gold">Case & Dial:</strong> ${CASE_OPTIONS[state.caseColor].name} + ${DIAL_OPTIONS[state.dialColor].name}</p>
                <p><strong class="text-gold">Custom Dial Name:</strong> ${state.customName ? state.customName : 'None'} | <strong class="text-gold">Custom Dial Photo:</strong> ${state.customPhotoDataUrl ? 'Uploaded (Circular)' : 'None'}</p>
                <p><strong class="text-gold">Back Case Cover:</strong> ${BACK_CASE_OPTIONS[state.backCase].name}</p>
                <p><strong class="text-gold">Strap & Lock:</strong> ${matObj.name} (${strapColorObj.name}) + ${STRAP_LOCKS[state.strapLock].name}</p>
                <p class="text-sm font-bold text-lightgold pt-1">Total Payable: ₹${state.totalPrice.toLocaleString('en-IN')}</p>
            `;
            openModal('checkoutModal');
        }

        function placeBespokeOrder(e) {
            e.preventDefault();
            const matObj = STRAP_MATERIALS[state.strapMaterial];
            const strapColorObj = matObj.colors[state.strapColorIndex] || matObj.colors[0];
            const orderId = 'DYN-' + Math.floor(100000 + Math.random() * 900000);
            const summary = `${CASE_OPTIONS[state.caseColor].name} | ${DIAL_OPTIONS[state.dialColor].name} | Name: "${state.customName || 'None'}" | Photo: ${state.customPhotoDataUrl ? 'Yes' : 'No'} | ${BACK_CASE_OPTIONS[state.backCase].name} | ${matObj.name} (${strapColorObj.name}) | ${STRAP_LOCKS[state.strapLock].name}`;

            const orderEntry = {
                orderId,
                date: new Date().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }),
                customerName: document.getElementById('orderName').value.trim(),
                phone: document.getElementById('orderPhone').value.trim(),
                address: document.getElementById('orderAddress').value.trim(),
                paymentMethod: document.getElementById('orderPaymentMethod').value,
                summary,
                totalPrice: state.totalPrice
            };

            const key = getStorageKey('orders');
            const orders = JSON.parse(localStorage.getItem(key) || '[]');
            orders.unshift(orderEntry);
            localStorage.setItem(key, JSON.stringify(orders));
            saveCurrentDesignToHistory();

            closeModal('checkoutModal');
            const waMsg = `Hello DYNAST! I have placed a Bespoke Custom Watch Order (${orderId}).\n\n*Specs:* ${summary}\n*Total:* ₹${state.totalPrice.toLocaleString('en-IN')}\n*Customer:* ${orderEntry.customerName} (${orderEntry.phone})\n*Address:* ${orderEntry.address}`;
            window.open(`https://wa.me/917579942958?text=${encodeURIComponent(waMsg)}`, '_blank');
            openAccountModal('orders');
        }

        function downloadWatchSnapshot() {
            const svgEl = document.getElementById('frontWatchSvg');
            const serializer = new XMLSerializer();
            const svgStr = serializer.serializeToString(svgEl);
            const canvas = document.createElement('canvas');
            canvas.width = 800;
            canvas.height = 1080;
            const ctx = canvas.getContext('2d');
            const img = new Image();
            const svgBlob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
            const url = URL.createObjectURL(svgBlob);
            img.onload = function() {
                ctx.fillStyle = '#070707';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.drawImage(img, 0, 0, 800, 1080);
                URL.revokeObjectURL(url);
                const a = document.createElement('a');
                a.download = `DYNAST_Custom_${state.customName || 'Watch'}.png`;
                a.href = canvas.toDataURL('image/png');
                a.click();
            };
            img.src = url;
        }
    </script>
</body>
